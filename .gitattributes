# Normalize line endings so the repo is identical on every platform.
* text=auto

# Shell scripts must keep LF. With CRLF, the shebang becomes "bash\r" and
# macOS/Linux fails with "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1 text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.ico binary
*.zip binary
